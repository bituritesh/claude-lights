# in .claude > settings.json

"hooks": {
"Stop": [{
        "hooks": [
          {
            "type": "command",
            "command": "B=$(cat); curl -s -o /dev/null --max-time 3 --connect-timeout 1 -X POST http://192.168.1.16/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || curl -s -o /dev/null --max-time 3 --connect-timeout 2 -X POST http://signal.local/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || true"
          }
        ]
}],
"SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "B=$(cat); curl -s -o /dev/null --max-time 3 --connect-timeout 1 -X POST http://192.168.1.16/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || curl -s -o /dev/null --max-time 3 --connect-timeout 2 -X POST http://signal.local/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
"UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "B=$(cat); curl -s -o /dev/null --max-time 3 --connect-timeout 1 -X POST http://192.168.1.16/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || curl -s -o /dev/null --max-time 3 --connect-timeout 2 -X POST http://signal.local/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
"Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "B=$(cat); curl -s -o /dev/null --max-time 3 --connect-timeout 1 -X POST http://192.168.1.16/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || curl -s -o /dev/null --max-time 3 --connect-timeout 2 -X POST http://signal.local/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
"StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "B=$(cat); curl -s -o /dev/null --max-time 3 --connect-timeout 1 -X POST http://192.168.1.16/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || curl -s -o /dev/null --max-time 3 --connect-timeout 2 -X POST http://signal.local/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
"SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "B=$(cat); curl -s -o /dev/null --max-time 3 --connect-timeout 1 -X POST http://192.168.1.16/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || curl -s -o /dev/null --max-time 3 --connect-timeout 2 -X POST http://signal.local/state -H \"X-Signal-Token: $SIGNAL_TOKEN\" -H \"Content-Type: application/json\" --data-binary \"$B\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
}